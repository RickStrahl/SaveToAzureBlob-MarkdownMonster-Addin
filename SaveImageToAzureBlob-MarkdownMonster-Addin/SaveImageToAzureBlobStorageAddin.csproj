<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.12</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Authors>Rick Strahl, West Wind Technologies</Authors>
    <Product>Markdown Monster Save Image To Azure Blob Storage Addin</Product>
    <Description>Lets you save images to Azure blob storage and link to the resulting image resource.</Description>
    <OutDir>$(UserProfile)\DropBox\Markdown Monster\Addins\SaveImageToAzureBlobStorage</OutDir>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\SaveImageToAzureBlobAddin.png" />
  </ItemGroup>

  <ItemGroup>
      <!-- Force Assets to be output  -->
	  <PackageReference Include="Azure.Identity" Version="1.17.1" IncludeAssets="all" />
	  <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" IncludeAssets="all" />

	  <PackageReference Include="FontAwesome6.Pro.Fonts" Version="2.5.1" IncludeAssets="compile" />
	  <PackageReference Include="MahApps.Metro" Version="2.4.11" IncludeAssets="compile" />
	  <PackageReference Include="Westwind.Utilities" Version="5.2.0" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ProgramFiles)\Markdown Monster\MarkdownMonster.dll">
		<IncludeAssets>Compile</IncludeAssets>
	    <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SaveImageToAzureBlobAddin.png" />
    <Resource Include="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>  

</Project>



